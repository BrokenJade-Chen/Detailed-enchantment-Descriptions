{
  "schemaVersion": 1,
  "id": "detailed_enchantment_descriptions",
  "version": "${version}",
  "name": "Detailed Enchantment Descriptions",
  "description": "Adds precise, level-scaled enchantment descriptions to item tooltips, computed from the game's own enchantment data.",
  "authors": [
    "BrokenJade-Chen"
  ],
  "contact": {
    "homepage": "https://github.com/BrokenJade-Chen/detailed-enchantment-descriptions",
    "sources": "https://github.com/BrokenJade-Chen/detailed-enchantment-descriptions",
    "issues": "https://github.com/BrokenJade-Chen/detailed-enchantment-descriptions/issues"
  },
  "license": "MIT",
  "icon": "assets/detailed_enchantment_descriptions/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.chenjl.detailedench.DetailedEnchantmentDescriptions"
    ],
    "modmenu": [
      "dev.chenjl.detailedench.compat.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${mcver}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
